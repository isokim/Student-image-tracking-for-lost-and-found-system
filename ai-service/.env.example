# Must match AI_SERVICE_TOKEN in backend/.env.
AI_SERVICE_TOKEN=change-me-locally

# auto | siglip | fallback
AI_EMBEDDING_BACKEND=auto

# Optional. Only used by /analyze; the service runs fine without Ollama.
# moondream needs ~1.7 GB RAM; llava:7b needs ~4 GB and often won't load
# on an 8 GB machine.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=moondream

# Once the SigLIP model has downloaded, uncomment these to skip the
# online check on every start (it hangs on a flaky connection).
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
