# The Laravel API. The trailing /api matters - apiClient strips it to
# build the /sanctum/csrf-cookie URL.
# Port 8000 is taken by another Laravel project on this machine, so
# the backend runs on 8002. Must match APP_URL/SERVER_PORT in
# backend/.env.
VITE_API_URL=http://localhost:8002/api

# Laravel Reverb, for live notifications. These must match the REVERB_*
# values in backend/.env. The app still works without Reverb running;
# notifications just arrive on page load instead of instantly.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
# Must match REVERB_PORT in backend/.env - 8080 is taken by another
# dev server on this machine.
VITE_REVERB_PORT=8085
VITE_REVERB_SCHEME=http
