# Copy to .env, then run:
#   php artisan key:generate
#   php artisan install:broadcasting --reverb   (fills the REVERB_* values)

APP_NAME="Lost & Found"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Store everything in UTC; the React app formats to the viewer's local
# East African Time. Dates are stored as written in this timezone.
APP_TIMEZONE=Africa/Nairobi
# Port 8000 is taken by another Laravel project on this machine
# (Desktop\modellyackend), so this app runs on 8002.
APP_URL=http://localhost:8002

# Read by `php artisan serve`, so the port does not have to be passed
# as a flag every time.
SERVER_PORT=8002

# The Vite dev server. Used for CORS + Sanctum stateful domains + reset links.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# 10 keeps sign-in responsive on a laptop CPU; raise on production
# hardware if you want more margin against offline cracking.
BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lost_and_found
DB_USERNAME=root
DB_PASSWORD=

# --- Sanctum SPA (cookie) authentication -----------------------------------
# The React app sends credentials, so the session cookie must be readable by
# localhost on any port. SANCTUM_STATEFUL_DOMAINS lists the origins allowed
# to authenticate with cookies instead of bearer tokens.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Left empty on purpose: the cookie is then host-only, scoped to
# whichever hostname served it. Pinning it to "localhost" would stop
# the session working if you open the app on 127.0.0.1 instead.
# Cookies ignore port numbers, so :5173 and :8000 still share it.
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8002,127.0.0.1:8002

# --- Queues ----------------------------------------------------------------
# AI analysis runs on the queue so users never wait for the vision model.
QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local

# --- Local AI service (Python FastAPI + Ollama + FAISS) --------------------
# Swapping this for a cloud URL is the only change needed to move the AI
# service off this machine. The frontend never talks to it directly.
AI_SERVICE_ENABLED=true
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT=30

# Separate, much larger budget for image analysis: a 7B vision model on
# CPU takes minutes per image. Only queued jobs wait on this.
AI_SERVICE_ANALYZE_TIMEOUT=300
AI_SERVICE_TOKEN=change-me-locally

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@lostandfound.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Broadcasting: Laravel Reverb, runs locally ----------------------------
# Start it with:  php artisan reverb:start
#
# Reverb is OPTIONAL. Notifications are written to the database first and
# broadcast second, so with Reverb stopped the app still works - alerts
# simply appear on page load instead of instantly. You will see the
# broadcast jobs fail in the queue worker; that is the websocket leg
# failing, not the notification being lost.
#
# These credentials were generated by `artisan install:broadcasting`.
# The VITE_* lines below are read by the React app when it connects.
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"

# Moved off 8080: a Node dev server holds that port on this machine, so
# Reverb could not bind and every broadcast POSTed into that app instead,
# coming back as HTML ("Pusher error: <!DOCTYPE html>").
#
# Two settings, and BOTH matter:
#   REVERB_SERVER_PORT - where the Reverb process binds
#   REVERB_PORT        - where clients (Laravel's broadcaster, and the
#                        React app) connect
# Setting only one leaves the server and its clients on different ports.
REVERB_PORT=8085
REVERB_SERVER_PORT=8085
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
